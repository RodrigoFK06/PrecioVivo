# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la PLANTILLA. `.env*` a secas tapaba el `!.env.example` de la
# .gitignore raiz, asi que web/.env.example nunca se commiteo — pese a que
# README.md y DEPLOY.md mandan a leerlo. Quien clonaba el repo recibia
# instrucciones que apuntaban a un archivo inexistente.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
