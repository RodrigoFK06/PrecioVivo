# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
.vercel/
*.tsbuildinfo

# --- Source data + dev DB (LEGAL §0.5: never re-host source PDFs/prose; keep local-only) ---
# Only the repo-root data/ (raw PDFs + dev SQLite). web/data/snapshot.json — derived
# numeric facts (legal-safe) — IS tracked so Vercel can build the live site.
/data/
*.pdf
*.db
*.sqlite

# --- Logs de corridas largas (backfill del indice, etc.) ---
*.log

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Grafo de conocimiento (graphify) ---
# Derivado del codigo: se regenera con `graphify . --code-only`.
graphify-out/

# --- Banco de pruebas del lakehouse ---
# El CSV del dato real se regenera con `python lakehouse/exportar_real.py` en un
# segundo, cambia cada dia con la corrida de la tuberia, y son 2 MB. El PERFIL
# (perfil_gmml.json, 13,5 KB) SI se versiona: es el artefacto que viaja a
# Databricks y el que hay que poder auditar.
lakehouse/gmml_real.csv
lakehouse/*.parquet
lakehouse/.tmp/
